# Copy to .env (git-ignored) or set these as real environment variables. Real variables win.

# Where the server listens.
PORT=4050
HOST=0.0.0.0

# Public address of the site, without a trailing slash. Used for canonical links, the sitemap,
# robots.txt, llms.txt and social preview tags. Without it each request's Host header is used.
SITE_URL=https://asterio.example

# How many reverse proxies sit in front of Node (nginx, Caddy, Cloudflare, a load balancer).
# Rate limiting reads the visitor's IP from X-Forwarded-For only when this is above 0.
# Leave it at 0 when Node faces the internet directly, or anyone can fake their IP.
TRUST_PROXY=1

# Other sites allowed to read the public data API (/api/tle, /api/swpc, /api/health) from a browser,
# comma separated. Account endpoints are never shared. Leave empty to allow only this site.
ALLOWED_ORIGINS=

# Google sign-in. Create an OAuth client of type "Web application" in Google Cloud Console
# (APIs & Services > Credentials) and add SITE_URL under "Authorized JavaScript origins".
# Leave empty to hide sign-in; saved objects then stay in the browser only.
GOOGLE_CLIENT_ID=

# Signs session cookies. At least 32 random characters, e.g. from: openssl rand -base64 48
# If unset, one is generated once and stored in DATA_DIR/session-secret.
SESSION_SECRET=

# How long a sign-in lasts.
SESSION_DAYS=30

# Where accounts (users.json) and the generated session secret are kept. Back this folder up.
DATA_DIR=.data

# Log every request (method, path, status, time).
LOG=
